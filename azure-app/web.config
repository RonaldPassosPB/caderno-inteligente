<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="index.cjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="node-app" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.cjs" />
        </rule>
      </rules>
    </rewrite>
    <!-- sem compressão dinâmica e com flush imediato, para o streaming do tutor chegar aos poucos -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <!-- sem nodeProcessCommandLine: o App Service usa a versão de WEBSITE_NODE_DEFAULT_VERSION -->
    <iisnode flushResponse="true" loggingEnabled="true" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
